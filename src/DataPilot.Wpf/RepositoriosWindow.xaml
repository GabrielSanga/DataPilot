<Window x:Class="DataPilot.Wpf.RepositoriosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repositórios" Height="360" Width="420" MinHeight="260" MinWidth="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Nome da pasta dentro da raiz dos fontes do usuário ia. Apenas letras, dígitos, &quot;_&quot;, &quot;.&quot; e &quot;-&quot;."/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Adicionar" Padding="10,3" Margin="6,0,0,0"
                    IsDefault="True" Click="Adicionar_Click"/>
            <TextBox x:Name="CampoPasta" VerticalContentAlignment="Center" MaxLength="100"/>
        </DockPanel>
        <TextBlock x:Name="Mensagem" DockPanel.Dock="Top" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button DockPanel.Dock="Bottom" Content="Remover selecionado" Padding="10,3" Margin="0,8,0,0"
                HorizontalAlignment="Left" Click="Remover_Click"/>
        <ListBox x:Name="Lista" ItemsSource="{Binding Repositorios}" DisplayMemberPath="Pasta"/>
    </DockPanel>
</Window>
