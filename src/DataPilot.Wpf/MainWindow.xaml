<Window x:Class="DataPilot.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DataPilot.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="DataPilot — Sessões" Height="480" Width="860" MinWidth="620" MinHeight="240">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BotaoNovaSessao" Content="Nova sessão" Padding="10,3" Margin="0,0,6,0"
                        IsEnabled="{Binding DadosDisponiveis}" Click="NovaSessao_Click"/>
                <Button x:Name="BotaoRepositorios" Content="Repositórios" Padding="10,3" Margin="0,0,12,0"
                        IsEnabled="{Binding DadosDisponiveis}" Click="Repositorios_Click"/>
                <CheckBox Content="Mostrar antigas" VerticalAlignment="Center"
                          IsChecked="{Binding MostrarAntigas}"/>
            </StackPanel>
            <TextBlock Text="{Binding Resumo}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1"
                Visibility="{Binding PastaIndisponivel, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" Foreground="#664D03"/>
        </Border>

        <Border x:Name="AvisoDadosBorda" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DadosDisponiveis}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding AvisoDados}" TextWrapping="Wrap" Foreground="#664D03"/>
        </Border>

        <Grid>
            <ListBox ItemsSource="{Binding Sessoes}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SessaoItem}">
                        <Grid Margin="2,4" ToolTip="{Binding Dica}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Agente}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Pasta}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Registro}" TextTrimming="CharacterEllipsis"
                                           FontSize="11" Foreground="#1565C0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PodeRetomar}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{Binding CorFundo}" CornerRadius="3" Padding="8,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusTexto}" Foreground="{Binding CorTexto}"/>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding Tempo}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="#616161"/>
                            <Button Grid.Column="4" Content="Retomar" Margin="8,0,0,0" Padding="8,2"
                                    VerticalAlignment="Center" Command="{Binding RetomarCommand}"
                                    Visibility="{Binding PodeRetomar, Converter={StaticResource BoolParaVisibilidade}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Nenhuma sessão." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#757575"
                       Visibility="{Binding SemSessoes, Converter={StaticResource BoolParaVisibilidade}}"/>
        </Grid>
    </DockPanel>
</Window>
