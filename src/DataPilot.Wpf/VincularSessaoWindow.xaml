<Window x:Class="DataPilot.Wpf.VincularSessaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincular sessão" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="Descricao" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="Demanda" Margin="0,0,0,2"/>
        <ComboBox x:Name="CampoDemanda" DisplayMemberPath="Texto" Margin="0,0,0,8"
                  SelectionChanged="Demanda_SelectionChanged"/>
        <TextBlock Text="Repositório (da demanda ou um novo: apenas letras, dígitos, &quot;_&quot;, &quot;.&quot; e &quot;-&quot;)" TextWrapping="Wrap" Margin="0,0,0,2"/>
        <ComboBox x:Name="CampoRepositorio" IsEditable="True" Margin="0,0,0,8"/>
        <TextBlock Text="Rótulo (opcional, até 40 caracteres, sem &quot;;&quot;)" Margin="0,0,0,2"/>
        <TextBox x:Name="CampoRotulo" MaxLength="40" Margin="0,0,0,4"/>
        <TextBlock x:Name="Mensagem" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vincular" Padding="14,3" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Padding="14,3" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
