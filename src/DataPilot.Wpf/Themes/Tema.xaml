<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:DataPilot.Wpf.ViewModels">

    <!-- ===== Cores (decisão 2 do design) ===== -->
    <SolidColorBrush x:Key="Nevoa" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="Papel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Trilho" Color="#E8ECEF"/>
    <SolidColorBrush x:Key="Grafite" Color="#2B3440"/>
    <SolidColorBrush x:Key="GrafiteClaro" Color="#5B6672"/>
    <SolidColorBrush x:Key="Linha" Color="#D9DEE3"/>
    <SolidColorBrush x:Key="SobreGrafite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Realce" Color="#EEF1F4"/>
    <SolidColorBrush x:Key="Desabilitado" Color="#8A949C"/>
    <SolidColorBrush x:Key="SelecaoBorda" Color="Transparent"/>
    <SolidColorBrush x:Key="Veu" Color="#26000000"/>

    <!-- Sinais de status: faixa, indicador e texto sobre fundo claro. -->
    <SolidColorBrush x:Key="SinalAtencao" Color="#C8102E"/>
    <SolidColorBrush x:Key="TextoAtencao" Color="#A30D25"/>
    <SolidColorBrush x:Key="SinalAguardando" Color="#F2A900"/>
    <SolidColorBrush x:Key="TextoAguardando" Color="#6B4A00"/>
    <SolidColorBrush x:Key="SinalExecutando" Color="#1F5FBF"/>
    <SolidColorBrush x:Key="SinalAtiva" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="SinalNeutro" Color="#8A949C"/>
    <SolidColorBrush x:Key="TextoNeutro" Color="#6E7781"/>

    <!-- Alerta do topo. -->
    <SolidColorBrush x:Key="AlertaVermelhoFundo" Color="#C8102E"/>
    <SolidColorBrush x:Key="AlertaVermelhoTexto" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AlertaAmareloFundo" Color="#F2A900"/>
    <SolidColorBrush x:Key="AlertaAmareloTexto" Color="#3A2A00"/>

    <!-- Faixas de erro, aviso e informação. -->
    <SolidColorBrush x:Key="ErroFundo" Color="#FBE9EC"/>
    <SolidColorBrush x:Key="ErroBorda" Color="#C8102E"/>
    <SolidColorBrush x:Key="ErroTexto" Color="#A30D25"/>
    <SolidColorBrush x:Key="AvisoFundo" Color="#FFF3CD"/>
    <SolidColorBrush x:Key="AvisoBorda" Color="#E0B85A"/>
    <SolidColorBrush x:Key="AvisoTexto" Color="#6B4A00"/>

    <!-- ===== Fontes e escala (decisão 3). Sem a Bahnschrift, a família cai para a Segoe UI. ===== -->
    <FontFamily x:Key="FonteInstrumento">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="FonteTexto">Segoe UI</FontFamily>
    <FontFamily x:Key="FonteIcones">Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="TamMeta">11</sys:Double>
    <sys:Double x:Key="TamSecundario">12</sys:Double>
    <sys:Double x:Key="TamCorpo">13</sys:Double>
    <sys:Double x:Key="TamTitulo">15</sys:Double>
    <sys:Double x:Key="TamIdentificador">26</sys:Double>

    <!-- ===== Indicador de foco: contorno grafite de 2 px, afastado 2 px do controle. ===== -->
    <Style x:Key="EstiloFoco">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" SnapsToDevicePixels="True" StrokeThickness="2" RadiusX="3" RadiusY="3"
                               Stroke="{DynamicResource Grafite}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Itens de lista ficam rente à borda da lista, então o contorno de foco deles vai por dentro. -->
    <Style x:Key="EstiloFocoInterno">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" SnapsToDevicePixels="True" StrokeThickness="2" RadiusX="2" RadiusY="2"
                               Stroke="{DynamicResource Grafite}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Janelas ===== -->
    <Style x:Key="EstiloJanela" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Nevoa}"/>
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="EstiloDialogo" TargetType="Window" BasedOn="{StaticResource EstiloJanela}">
        <Setter Property="Background" Value="{DynamicResource Papel}"/>
    </Style>

    <!-- ===== Textos ===== -->
    <Style x:Key="TextoSecundario" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GrafiteClaro}"/>
        <Setter Property="FontSize" Value="{StaticResource TamSecundario}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TextoMeta" TargetType="TextBlock" BasedOn="{StaticResource TextoSecundario}">
        <Setter Property="FontSize" Value="{StaticResource TamMeta}"/>
    </Style>
    <Style x:Key="TextoErro" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ErroTexto}"/>
        <Setter Property="FontSize" Value="{StaticResource TamSecundario}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TextoCampo" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="TextoInstrumento" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteInstrumento}"/>
    </Style>
    <Style x:Key="TextoNumero" TargetType="TextBlock" BasedOn="{StaticResource TextoInstrumento}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Typography.NumeralStyle" Value="Lining"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style x:Key="Icone" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteIcones}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="AutomationProperties.IsOffscreenBehavior" Value="Offscreen"/>
    </Style>

    <!-- ===== Sinais de status: o mesmo nível vira faixa, indicador e texto ===== -->
    <Style x:Key="FaixaSinal" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Atencao}">
                <Setter Property="Background" Value="{DynamicResource SinalAtencao}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Aguardando}">
                <Setter Property="Background" Value="{DynamicResource SinalAguardando}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PontoStatus" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource SinalNeutro}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Atencao}">
                <Setter Property="Fill" Value="{DynamicResource SinalAtencao}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Aguardando}">
                <Setter Property="Fill" Value="{DynamicResource SinalAguardando}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Executando}">
                <Setter Property="Fill" Value="{DynamicResource SinalExecutando}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Ativa}">
                <Setter Property="Fill" Value="{DynamicResource SinalAtiva}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TextoStatus" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextoNeutro}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Atencao}">
                <Setter Property="Foreground" Value="{DynamicResource TextoAtencao}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Aguardando}">
                <Setter Property="Foreground" Value="{DynamicResource TextoAguardando}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Executando}">
                <Setter Property="Foreground" Value="{DynamicResource SinalExecutando}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static local:NivelSinal.Ativa}">
                <Setter Property="Foreground" Value="{DynamicResource SinalAtiva}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Botões: secundário (padrão), principal, discreto, de ícone e do alerta ===== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="Background" Value="{DynamicResource Papel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GrafiteClaro}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Moldura" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Realce}"/>
                            <Setter TargetName="Moldura" Property="BorderBrush" Value="{DynamicResource Grafite}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Linha}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Desabilitado}"/>
                            <Setter TargetName="Moldura" Property="BorderBrush" Value="{DynamicResource Linha}"/>
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Papel}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource SobreGrafite}"/>
        <Setter Property="Background" Value="{DynamicResource Grafite}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Grafite}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Moldura" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Moldura" Property="BorderBrush" Value="{DynamicResource GrafiteClaro}"/>
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource GrafiteClaro}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Moldura" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Linha}"/>
                            <Setter TargetName="Moldura" Property="BorderBrush" Value="{DynamicResource Linha}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Desabilitado}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoDiscreto" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoIcone" TargetType="Button" BasedOn="{StaticResource BotaoDiscreto}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Botão sobre o alerta: herda a cor do texto do alerta, sem fundo próprio. -->
    <Style x:Key="BotaoNoAlerta" TargetType="Button">
        <!-- O estilo do tema do WPF vale por baixo do nosso e fixa a cor do texto; a do alerta é pedida de forma explícita. -->
        <Setter Property="Foreground"
                Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type Border}}}"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Moldura" Background="Transparent" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Veu}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Moldura" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Escolha em botões (usada para o agente): um só marcado por grupo. -->
    <Style x:Key="EscolhaBotao" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="Background" Value="{DynamicResource Papel}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="22,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Moldura" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GrafiteClaro}"
                            BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Realce}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Grafite}"/>
                            <Setter TargetName="Moldura" Property="BorderBrush" Value="{DynamicResource Grafite}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SobreGrafite}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Item da lista de demandas ===== -->
    <Style x:Key="ItemTrilho" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoInterno}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Moldura" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Realce}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Papel}"/>
                            <Setter TargetName="Moldura" Property="BorderBrush" Value="{DynamicResource SelecaoBorda}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem" x:Key="ItemLista">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoInterno}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Moldura" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Realce}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Grafite}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SobreGrafite}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListaSimples" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Papel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GrafiteClaro}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ItemLista}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- ===== Campo de texto ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="Background" Value="{DynamicResource Papel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GrafiteClaro}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Grafite}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Grafite}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource SobreGrafite}"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Moldura" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                        <!-- Foco: um segundo fio por dentro, para o contorno ficar com 2 px sem deslocar o texto. -->
                        <Border x:Name="Foco" Margin="1" BorderThickness="1" CornerRadius="2" Visibility="Collapsed"
                                BorderBrush="{DynamicResource Grafite}"/>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Moldura" Property="BorderBrush" Value="{DynamicResource Grafite}"/>
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Desabilitado}"/>
                            <Setter TargetName="Moldura" Property="BorderBrush" Value="{DynamicResource Linha}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ModeloTextoSemBorda" TargetType="TextBox">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
    </ControlTemplate>

    <!-- ===== Caixa de combinação (editável ou não) ===== -->
    <Style x:Key="AlternarCombo" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Seta" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                              Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Grafite}" StrokeThickness="1.6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Moldura" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Realce}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Moldura" Property="Background" Value="{DynamicResource Linha}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Moldura" Grid.ColumnSpan="2" Background="{DynamicResource Papel}"
                                BorderBrush="{DynamicResource GrafiteClaro}" BorderThickness="1" CornerRadius="3"/>
                        <ToggleButton x:Name="Alternar" Grid.ColumnSpan="2" Style="{StaticResource AlternarCombo}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="Conteudo" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="7,0,0,0" VerticalAlignment="Center"
                                 Background="Transparent" Padding="0,5" Template="{StaticResource ModeloTextoSemBorda}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True" PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Moldura}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Papel}" BorderBrush="{DynamicResource GrafiteClaro}" BorderThickness="1"
                                    CornerRadius="3" Margin="0,2,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Alternar" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="Alternar" Property="Grid.ColumnSpan" Value="1"/>
                            <Setter TargetName="Conteudo" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Moldura" Property="BorderBrush" Value="{DynamicResource Grafite}"/>
                            <Setter TargetName="Moldura" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Desabilitado}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Caixa de seleção ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFoco}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Caixa" Width="16" Height="16" VerticalAlignment="Center" CornerRadius="2" BorderThickness="1.5"
                                BorderBrush="{DynamicResource GrafiteClaro}" Background="{DynamicResource Papel}">
                            <Path x:Name="Marca" Data="M2.5,7.5 L5.8,10.8 L11.5,4.2" Stroke="{DynamicResource SobreGrafite}"
                                  StrokeThickness="1.8" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource Grafite}"/>
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Grafite}"/>
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource Grafite}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Desabilitado}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barra de progresso: grafite, nunca verde (verde é o status "ativa") ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{DynamicResource Linha}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource Grafite}" CornerRadius="3"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Dica ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="{StaticResource TamSecundario}"/>
        <Setter Property="MaxWidth" Value="460"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Papel}" BorderBrush="{DynamicResource GrafiteClaro}" BorderThickness="1"
                            CornerRadius="3" Padding="9,6">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Menu "Mais ações" ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteTexto}"/>
        <Setter Property="FontSize" Value="{StaticResource TamCorpo}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Papel}" BorderBrush="{DynamicResource GrafiteClaro}" BorderThickness="1"
                            CornerRadius="3" Padding="0,4" MinWidth="190">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Fundo" Background="Transparent" Padding="14,7">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Realce}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Desabilitado}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
