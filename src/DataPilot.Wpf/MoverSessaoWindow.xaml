<Window x:Class="DataPilot.Wpf.MoverSessaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mover sessão" Height="320" Width="400" MinHeight="220" MinWidth="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Demanda de destino. O repositório da sessão é vinculado ao destino se ainda não estiver."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Mover" Padding="14,3" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Padding="14,3" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="Lista" DisplayMemberPath="Texto" MouseDoubleClick="Lista_DoubleClick"/>
    </DockPanel>
</Window>
