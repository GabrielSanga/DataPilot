<Window x:Class="DataPilot.Wpf.DemandaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EstiloDialogo}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Trabalho" SizeToContent="Height" Width="440" ResizeMode="NoResize">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="TituloJanela" FontSize="{StaticResource TamTitulo}" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Text="Título" Style="{StaticResource TextoCampo}"/>
        <TextBox x:Name="CampoTitulo" MaxLength="80" AutomationProperties.Name="Título"/>
        <TextBlock x:Name="ErroTitulo" Style="{StaticResource TextoErro}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="Principal" Style="{StaticResource BotaoPrincipal}" Margin="0,0,8,0" MinWidth="110"
                    IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" IsCancel="True" MinWidth="86"/>
        </StackPanel>
    </StackPanel>
</Window>
