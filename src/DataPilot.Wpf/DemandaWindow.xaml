<Window x:Class="DataPilot.Wpf.DemandaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Demanda" SizeToContent="Height" Width="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="Identificador (até 30 caracteres: letras, dígitos, &quot;_&quot;, &quot;.&quot; e &quot;-&quot;)" TextWrapping="Wrap" Margin="0,0,0,2"/>
        <TextBox x:Name="CampoId" MaxLength="30" Margin="0,0,0,8"/>
        <TextBlock Text="Título (até 80 caracteres)" Margin="0,0,0,2"/>
        <TextBox x:Name="CampoTitulo" MaxLength="80" Margin="0,0,0,8"/>
        <TextBlock Text="Change do OpenSpec (opcional, mesmo conjunto de caracteres do identificador)" TextWrapping="Wrap" Margin="0,0,0,2"/>
        <TextBox x:Name="CampoOpenspec" MaxLength="100" Margin="0,0,0,4"/>
        <TextBlock x:Name="Mensagem" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Salvar" Padding="14,3" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Padding="14,3" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
