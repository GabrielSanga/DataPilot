<Window x:Class="DataPilot.Wpf.DemandaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EstiloDialogo}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Demanda" SizeToContent="Height" Width="460" ResizeMode="NoResize">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="TituloJanela" FontSize="{StaticResource TamTitulo}" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Text="Identificador" Style="{StaticResource TextoCampo}"/>
        <TextBox x:Name="CampoId" MaxLength="30" AutomationProperties.Name="Identificador"/>
        <TextBlock Text="Até 30 caracteres: letras, dígitos, &quot;_&quot;, &quot;.&quot; e &quot;-&quot;." Style="{StaticResource TextoMeta}" Margin="0,4,0,0"/>
        <TextBlock x:Name="ErroId" Style="{StaticResource TextoErro}"/>

        <TextBlock Text="Título" Style="{StaticResource TextoCampo}" Margin="0,14,0,4"/>
        <TextBox x:Name="CampoTitulo" MaxLength="80" AutomationProperties.Name="Título"/>
        <TextBlock Text="Até 80 caracteres." Style="{StaticResource TextoMeta}" Margin="0,4,0,0"/>
        <TextBlock x:Name="ErroTitulo" Style="{StaticResource TextoErro}"/>

        <TextBlock Text="Change do OpenSpec (opcional)" Style="{StaticResource TextoCampo}" Margin="0,14,0,4"/>
        <TextBox x:Name="CampoOpenspec" MaxLength="100" AutomationProperties.Name="Change do OpenSpec"/>
        <TextBlock Text="Mesmo conjunto de caracteres do identificador." Style="{StaticResource TextoMeta}" Margin="0,4,0,0"/>
        <TextBlock x:Name="ErroOpenspec" Style="{StaticResource TextoErro}"/>

        <TextBlock x:Name="ErroGeral" Style="{StaticResource TextoErro}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="Principal" Style="{StaticResource BotaoPrincipal}" Margin="0,0,8,0" MinWidth="110"
                    IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" IsCancel="True" MinWidth="86"/>
        </StackPanel>
    </StackPanel>
</Window>
