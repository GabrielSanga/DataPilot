<Window x:Class="DataPilot.Wpf.NovaSessaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova sessão" SizeToContent="Height" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="Repositório" Margin="0,0,0,2"/>
        <ComboBox x:Name="CampoRepositorio" DisplayMemberPath="Pasta" Margin="0,0,0,8"/>
        <TextBlock Text="Agente" Margin="0,0,0,2"/>
        <ComboBox x:Name="CampoAgente" Margin="0,0,0,8">
            <ComboBoxItem Content="Claude" IsSelected="True"/>
            <ComboBoxItem Content="Codex"/>
        </ComboBox>
        <TextBlock Text="Rótulo (opcional, até 40 caracteres, sem &quot;;&quot;)" Margin="0,0,0,2"/>
        <TextBox x:Name="CampoRotulo" MaxLength="40" Margin="0,0,0,4"/>
        <TextBlock x:Name="Mensagem" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abrir" Padding="14,3" Margin="0,0,6,0" IsDefault="True" Click="Abrir_Click"/>
            <Button Content="Cancelar" Padding="14,3" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
