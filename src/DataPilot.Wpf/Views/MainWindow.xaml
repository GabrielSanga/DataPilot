<Window x:Class="DataPilot.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DataPilot.Wpf.ViewModels"
        xmlns:conv="clr-namespace:DataPilot.Wpf.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Style="{StaticResource EstiloJanela}"
        Title="DataPilot" Height="680" Width="1140" MinWidth="820" MinHeight="420">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>

        <ContextMenu x:Key="MenuSessao"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     IsEnabled="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Vincular a um trabalho" Command="{Binding VincularCommand}"
                      IsEnabled="{Binding PodeVincular}"/>
        </ContextMenu>

        <ContextMenu x:Key="MenuLancamento"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     IsEnabled="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Cancelar" Command="{Binding CancelarCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="MenuRepositorio"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     IsEnabled="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Trocar change" Command="{Binding TrocarChangeCommand}"/>
            <MenuItem Header="Remover repositório" Command="{Binding RemoverRepositorioCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="MenuDemanda"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     IsEnabled="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Editar" Command="{Binding EditarCommand}"
                      Visibility="{Binding PodeEditar, Converter={StaticResource BoolParaVisibilidade}}"/>
            <MenuItem Header="Arquivar" Command="{Binding ArquivarCommand}"
                      Visibility="{Binding PodeArquivar, Converter={StaticResource BoolParaVisibilidade}}"/>
            <MenuItem Header="Desarquivar" Command="{Binding DesarquivarCommand}"
                      Visibility="{Binding PodeDesarquivar, Converter={StaticResource BoolParaVisibilidade}}"/>
        </ContextMenu>

        <DataTemplate x:Key="LinhaSessao" DataType="{x:Type local:SessaoItem}">
            <Grid MinHeight="46" Background="{DynamicResource Papel}" ToolTip="{Binding Dica}"
                  Tag="{Binding DataContext.DadosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EmSessoes}" Value="True">
                                <Setter Property="ContextMenu" Value="{StaticResource MenuSessao}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="Auto" MinWidth="104"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource FaixaSinal}"/>
                <Ellipse Grid.Column="1" Style="{StaticResource PontoStatus}" HorizontalAlignment="Center"
                         AutomationProperties.Name="{Binding StatusTexto}"/>
                <TextBlock Grid.Column="2" Text="{Binding Agente}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,6,8,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Pasta}" Style="{StaticResource TextoInstrumento}" FontWeight="SemiBold"
                                   Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding EmSessoes, Converter={StaticResource BoolParaVisibilidade}}"/>
                        <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Motivo}" Style="{StaticResource TextoMeta}" TextWrapping="Wrap"
                               Visibility="{Binding MostrarMotivo, Converter={StaticResource BoolParaVisibilidade}}"/>
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding Tempo}" Style="{StaticResource TextoNumero}"
                           Foreground="{DynamicResource GrafiteClaro}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button Grid.Column="5" Command="{Binding RetomarCommand}" VerticalAlignment="Center"
                        AutomationProperties.Name="Retomar" ToolTip="{Binding Motivo}" ToolTipService.ShowOnDisabled="True">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static conv:TodosVerdadeiros.Instancia}">
                            <Binding Path="PodeRetomar"/>
                            <Binding Path="DataContext.DadosDisponiveis" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE768;" FontSize="11" Margin="0,0,7,0"/>
                        <TextBlock Text="Retomar"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource BotaoIcone}" Command="{Binding ExcluirCommand}"
                        IsEnabled="{Binding DataContext.DadosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="Excluir sessão" ToolTip="Excluir sessão">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE74D;"/>
                </Button>
                <Button Grid.Column="7" Style="{StaticResource BotaoIcone}" Click="MaisAcoes_Click"
                        Visibility="{Binding EmSessoes, Converter={StaticResource BoolParaVisibilidade}}"
                        AutomationProperties.Name="Mais ações da sessão" ToolTip="Mais ações">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE712;"/>
                </Button>
                <Border Grid.ColumnSpan="8" BorderBrush="{DynamicResource Linha}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LinhaLancamento" DataType="{x:Type local:LancamentoItem}">
            <Grid MinHeight="46" Background="{DynamicResource Papel}" ContextMenu="{StaticResource MenuLancamento}"
                  ToolTip="Ainda não é uma sessão: ela aparece aqui quando a primeira mensagem for enviada."
                  Tag="{Binding DataContext.DadosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="Auto" MinWidth="104"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Text="{Binding Agente}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                    <TextBlock Text="{Binding Pasta}" Style="{StaticResource TextoInstrumento}" FontWeight="SemiBold"
                               Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding EmSessoes, Converter={StaticResource BoolParaVisibilidade}}"/>
                    <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <TextBlock Text="aguardando a primeira mensagem" Style="{StaticResource TextoSecundario}" FontStyle="Italic"/>
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding Tempo}" Style="{StaticResource TextoNumero}"
                           Foreground="{DynamicResource GrafiteClaro}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="5" Content="Abrir" Command="{Binding AbrirCommand}" VerticalAlignment="Center"
                        IsEnabled="{Binding DataContext.DadosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Abre o agente de novo neste repositório. Use quando a aba foi fechada antes da primeira mensagem."/>
                <Button Grid.Column="7" Style="{StaticResource BotaoIcone}" Click="MaisAcoes_Click"
                        AutomationProperties.Name="Mais ações do lançamento" ToolTip="Mais ações">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE712;"/>
                </Button>
                <Border Grid.ColumnSpan="8" BorderBrush="{DynamicResource Linha}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BaiaRepositorio" DataType="{x:Type local:CardItem}">
            <StackPanel Margin="0,0,0,28">
                <Grid ContextMenu="{StaticResource MenuRepositorio}"
                      Tag="{Binding DataContext.DadosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Pasta}" Style="{StaticResource TextoInstrumento}" FontSize="{StaticResource TamTitulo}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Change}" Style="{StaticResource TextoInstrumento}"
                                   Foreground="{DynamicResource GrafiteClaro}" VerticalAlignment="Bottom" Margin="12,0,0,1"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding TemChange, Converter={StaticResource BoolParaVisibilidade}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Nova sessão" Margin="0,0,4,0"
                            Command="{Binding NovaSessaoCommand}"
                            Visibility="{Binding PodeNovaSessao, Converter={StaticResource BoolParaVisibilidade}}"
                            IsEnabled="{Binding DataContext.DadosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Grid.Column="2" Style="{StaticResource BotaoIcone}" Click="MaisAcoes_Click"
                            AutomationProperties.Name="Mais ações do repositório" ToolTip="Mais ações">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE712;"/>
                    </Button>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding TemProgresso, Converter={StaticResource BoolParaVisibilidade}}">
                        <ProgressBar Width="150" Value="{Binding ProgressoFracao, Mode=OneWay}" Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding TemBarra, Converter={StaticResource BoolParaVisibilidade}}"/>
                        <TextBlock Text="{Binding ProgressoTexto}" Foreground="{DynamicResource GrafiteClaro}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Border Height="2" Background="{DynamicResource Grafite}" Margin="0,8,0,0"/>
                <ItemsControl ItemsSource="{Binding Sessoes}" ItemTemplate="{StaticResource LinhaSessao}" Focusable="False"/>
                <ItemsControl ItemsSource="{Binding Lancamentos}" ItemTemplate="{StaticResource LinhaLancamento}" Focusable="False"/>
                <TextBlock Text="Nenhuma sessão aqui ainda. Use &quot;Nova sessão&quot; para abrir o Claude ou o Codex neste repositório."
                           Margin="4,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSecundario}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Vazio}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DetalheDemanda" DataType="{x:Type local:DemandaItem}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,12,22" ContextMenu="{StaticResource MenuDemanda}"
                      Tag="{Binding DataContext.DadosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource TextoInstrumento}"
                                   FontSize="{StaticResource TamIdentificador}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="arquivado" Style="{StaticResource TextoMeta}" VerticalAlignment="Bottom" Margin="12,0,0,6"
                                   Visibility="{Binding Arquivada, Converter={StaticResource BoolParaVisibilidade}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Vincular repositório" Margin="14,0,4,0" VerticalAlignment="Center"
                            Command="{Binding VincularCommand}"
                            Visibility="{Binding PodeVincular, Converter={StaticResource BoolParaVisibilidade}}"
                            IsEnabled="{Binding DataContext.DadosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Grid.Column="2" Style="{StaticResource BotaoIcone}" Click="MaisAcoes_Click" VerticalAlignment="Center"
                            AutomationProperties.Name="Mais ações do trabalho" ToolTip="Mais ações">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE712;"/>
                    </Button>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Este trabalho ainda não tem repositórios. Use &quot;Vincular repositório&quot; para começar."
                                   Style="{StaticResource TextoSecundario}" FontSize="{StaticResource TamCorpo}"
                                   Visibility="{Binding SemRepositorios, Converter={StaticResource BoolParaVisibilidade}}"/>
                        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource BaiaRepositorio}" Focusable="False"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="DetalheSessoes" DataType="{x:Type local:DemandaItem}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,12,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sessões" Style="{StaticResource TextoInstrumento}" VerticalAlignment="Center"
                               FontSize="{StaticResource TamIdentificador}" FontWeight="SemiBold"/>
                    <CheckBox Grid.Column="1" Content="Mostrar antigas" VerticalAlignment="Center" Margin="24,0,0,0"
                              IsChecked="{Binding DataContext.MostrarAntigas, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="Inclui as sessões encerradas ou inativas há mais de 3 dias"/>
                    <Button Grid.Column="2" Content="Nova sessão" Margin="14,0,4,0" VerticalAlignment="Center"
                            Command="{Binding NovaSessaoCommand}"
                            IsEnabled="{Binding DataContext.DadosDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,0,12,0">
                            <Border Height="2" Background="{DynamicResource Grafite}"/>
                            <ItemsControl ItemsSource="{Binding Sessoes}" ItemTemplate="{StaticResource LinhaSessao}" Focusable="False"/>
                            <ItemsControl ItemsSource="{Binding LancamentosSessoes}" ItemTemplate="{StaticResource LinhaLancamento}" Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="Nenhuma sessão fora de trabalhos. Use &quot;Nova sessão&quot; para abrir o Claude ou o Codex."
                               Style="{StaticResource TextoSecundario}"
                               FontSize="{StaticResource TamCorpo}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SemSessoes, Converter={StaticResource BoolParaVisibilidade}}"/>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ItemDemanda" DataType="{x:Type local:DemandaItem}">
            <Border x:Name="Raiz" BorderBrush="{DynamicResource Linha}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource FaixaSinal}"/>
                    <StackPanel Grid.Column="1" Margin="12,8,10,9">
                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource TextoInstrumento}"
                                   FontSize="{StaticResource TamTitulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoMeta}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    Visibility="{Binding TemDestaque, Converter={StaticResource BoolParaVisibilidade}}">
                            <Ellipse Style="{StaticResource PontoStatus}" Margin="0,1,6,0"/>
                            <TextBlock Text="{Binding DestaqueTexto}" Style="{StaticResource TextoStatus}"
                                       FontSize="{StaticResource TamSecundario}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding EhSessoes}" Value="True">
                    <Setter TargetName="Raiz" Property="BorderThickness" Value="0,1,0,0"/>
                    <Setter TargetName="Raiz" Property="Margin" Value="0,10,0,0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Nevoa}" BorderBrush="{DynamicResource Linha}" BorderThickness="0,0,0,1" Padding="18,0" Height="54">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DataPilot" Style="{StaticResource TextoInstrumento}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ContagemAtencao}" FontWeight="SemiBold" Margin="26,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextoAtencao}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ContagemAguardando}" FontWeight="SemiBold" Margin="22,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextoAguardando}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ContagemExecutando}" Margin="22,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SinalExecutando}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <Border Margin="12,10,12,0" Padding="12,8" Background="{DynamicResource AvisoFundo}" BorderBrush="{DynamicResource AvisoBorda}" BorderThickness="1" CornerRadius="3" Visibility="{Binding PastaIndisponivel, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" Foreground="{DynamicResource AvisoTexto}"/>
            </Border>
            <Border Margin="12,10,12,0" Padding="12,8" Background="{DynamicResource AvisoFundo}" BorderBrush="{DynamicResource AvisoBorda}" BorderThickness="1" CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DadosDisponiveis}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding AvisoDados}" TextWrapping="Wrap" Foreground="{DynamicResource AvisoTexto}"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Trilho}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,14,14,10">
                        <Button x:Name="BotaoNovaDemanda" Style="{StaticResource BotaoPrincipal}" Click="NovaDemanda_Click" IsEnabled="{Binding DadosDisponiveis}" ToolTip="Novo trabalho (Ctrl+N)" AutomationProperties.Name="Novo trabalho">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Novo trabalho"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,10,0,0">
                            <TextBox x:Name="CampoFiltro" Padding="30,5,8,5" PreviewKeyDown="CampoFiltro_PreviewKeyDown" Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar trabalhos" ToolTip="Filtrar trabalhos (Ctrl+F)"/>
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="11,0,0,0" Foreground="{DynamicResource GrafiteClaro}" IsHitTestVisible="False"/>
                            <TextBlock Text="Filtrar trabalhos" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource GrafiteClaro}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CampoFiltro}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Linha}" BorderThickness="0,1,0,0" Padding="16,11">
                        <CheckBox Content="Mostrar arquivados" IsChecked="{Binding MostrarArquivadas}"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="16,0,16,10" Style="{StaticResource TextoSecundario}" Text="Nenhum trabalho." Visibility="{Binding SemDemandas, Converter={StaticResource BoolParaVisibilidade}}"/>
                    <ListBox x:Name="ListaDemandas" ItemsSource="{Binding DemandasFiltradas}" ItemContainerStyle="{StaticResource ItemTrilho}" ItemTemplate="{StaticResource ItemDemanda}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Trabalhos" SelectionChanged="ListaDemandas_SelectionChanged"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False" Focusable="False"/>

            <Grid Grid.Column="2" Margin="22,18,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,16" Padding="12,8,6,8" CornerRadius="3" BorderThickness="1" Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}" AutomationProperties.LiveSetting="Assertive">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Papel}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource GrafiteClaro}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErroFundo}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ErroBorda}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoIcone}" Width="26" Height="26" MinHeight="26" Command="{Binding FecharMensagemCommand}" VerticalAlignment="Top" AutomationProperties.Name="Fechar mensagem" ToolTip="Fechar">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE711;" FontSize="11"/>
                        </Button>
                        <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Grafite}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErroTexto}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ContentControl Content="{Binding DemandaSelecionada}" Focusable="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource DetalheDemanda}"/>
                                <Style.Triggers>
                                    <!-- Sem seleção, só a orientação aparece: nada de modelo de trabalho com dados vazios. -->
                                    <DataTrigger Binding="{Binding DemandaSelecionada}" Value="{x:Null}">
                                        <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DemandaSelecionada.EhSessoes}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource DetalheSessoes}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/aviao.png" Width="312" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"
                           AutomationProperties.Name="Avião em pixel art" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DemandaSelecionada}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
