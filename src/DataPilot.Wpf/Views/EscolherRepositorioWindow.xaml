<Window x:Class="DataPilot.Wpf.Views.EscolherRepositorioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EstiloDialogo}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Retomar sessão" SizeToContent="Height" Width="400" ResizeMode="NoResize">
    <StackPanel Margin="24,22,24,20">
        <TextBlock Text="Retomar sessão" FontSize="{StaticResource TamTitulo}" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Text="Repositório" Style="{StaticResource TextoCampo}"/>
        <ComboBox x:Name="CampoRepositorio" AutomationProperties.Name="Repositório"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Retomar" Style="{StaticResource BotaoPrincipal}" Margin="0,0,8,0" MinWidth="96"
                    IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" IsCancel="True" MinWidth="86"/>
        </StackPanel>
    </StackPanel>
</Window>
