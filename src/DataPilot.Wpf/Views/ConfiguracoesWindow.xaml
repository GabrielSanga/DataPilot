<Window x:Class="DataPilot.Wpf.Views.ConfiguracoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EstiloDialogo}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Configurações" SizeToContent="Height" Width="480" ResizeMode="NoResize">
    <StackPanel Margin="24,22,24,20">
        <TextBlock Text="Configurações" FontSize="{StaticResource TamTitulo}" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Text="Pasta de status das sessões de IA" Style="{StaticResource TextoCampo}"/>
        <TextBox x:Name="CampoPasta" IsReadOnly="True" Margin="0,0,0,16" AutomationProperties.Name="Pasta de status"/>

        <TextBlock Text="Executar os agentes em" Style="{StaticResource TextoCampo}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton x:Name="EscolhaContainer" Content="Container Docker" GroupName="Execucao" Margin="0,0,8,0"
                         Style="{StaticResource EscolhaBotao}" AutomationProperties.Name="Executar no Container Docker"/>
            <RadioButton x:Name="EscolhaWindows" Content="Windows" GroupName="Execucao"
                         Style="{StaticResource EscolhaBotao}" AutomationProperties.Name="Executar no Windows"/>
        </StackPanel>

        <TextBlock Text="Nome do container" Style="{StaticResource TextoCampo}"/>
        <TextBox x:Name="CampoContainer" MaxLength="63" AutomationProperties.Name="Nome do container"
                 IsEnabled="{Binding IsChecked, ElementName=EscolhaContainer}"/>
        <TextBlock x:Name="MensagemContainer" Style="{StaticResource TextoErro}"/>

        <CheckBox x:Name="CampoSsh" Content="Abrir pelo SSH" Margin="0,16,0,12" AutomationProperties.Name="Abrir pelo SSH"/>

        <TextBlock Text="Usuário do SSH" Style="{StaticResource TextoCampo}"/>
        <TextBox x:Name="CampoUsuario" MaxLength="20" AutomationProperties.Name="Usuário do SSH"
                 IsEnabled="{Binding IsChecked, ElementName=CampoSsh}"/>
        <TextBlock x:Name="Mensagem" Style="{StaticResource TextoErro}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="Principal" Content="Salvar" Style="{StaticResource BotaoPrincipal}" Margin="0,0,8,0" MinWidth="110"
                    IsDefault="True" Click="Salvar_Click"/>
            <Button Content="Cancelar" IsCancel="True" MinWidth="86"/>
        </StackPanel>
    </StackPanel>
</Window>
