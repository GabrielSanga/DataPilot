<Window x:Class="DataPilot.Wpf.Views.VincularRepositorioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EstiloDialogo}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Vincular repositório" SizeToContent="Height" Width="460" ResizeMode="NoResize">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="TituloJanela" FontSize="{StaticResource TamTitulo}" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Text="Pasta" Style="{StaticResource TextoCampo}"/>
        <DockPanel>
            <Button x:Name="BotaoEscolher" DockPanel.Dock="Right" Content="Escolher pasta…" Margin="8,0,0,0" Click="Escolher_Click"/>
            <TextBox x:Name="CampoPasta" IsReadOnly="True" AutomationProperties.Name="Pasta"/>
        </DockPanel>
        <TextBlock x:Name="ErroPasta" Style="{StaticResource TextoErro}"/>

        <TextBlock Text="Change do OpenSpec" Style="{StaticResource TextoCampo}" Margin="0,16,0,4"/>
        <ListBox x:Name="ListaChanges" MaxHeight="180" AutomationProperties.Name="Change do OpenSpec"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <TextBlock x:Name="ErroGeral" Style="{StaticResource TextoErro}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="Principal" Style="{StaticResource BotaoPrincipal}" Margin="0,0,8,0" MinWidth="96"
                    IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" IsCancel="True" MinWidth="86"/>
        </StackPanel>
    </StackPanel>
</Window>
